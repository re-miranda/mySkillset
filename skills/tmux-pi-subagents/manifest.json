{
  "name": "tmux-pi-subagents",
  "version": "1.2.1",
  "license": "0BSD",
  "entrypoint": "SKILL.md",
  "description": "Claude Code orchestrates Pi companions in tmux using stable pane IDs and file-watcher signaling.",
  "requirements": [
    "claude-code",
    "pi",
    "tmux",
    "bash"
  ],
  "validationCommand": "bash test.sh",
  "runtimeStateRoot": "/tmp/claude-agents",
  "installs": {
    "skill": "~/.claude/skills/tmux-pi-subagents",
    "commands": [
      "~/.claude/commands/spawn-pi.md",
      "~/.claude/commands/pi-subagents.md",
      "~/.claude/commands/tmux-subagents.md",
      "~/.claude/commands/poll.md"
    ],
    "scripts": [
      "~/.claude/bin/spawn-pi-agent",
      "~/.claude/bin/spawn-fable-agent",
      "~/.claude/bin/verify-pi-delivery",
      "~/.claude/bin/watch-pi-agent",
      "~/.claude/bin/poll-pi-agent",
      "~/.claude/bin/cleanup-pi-agent"
    ],
    "claudeAddendum": "upsert marked block in ~/.claude/CLAUDE.md",
    "tmuxAddendum": "optional marked block in ~/.tmux.conf"
  },
  "safety": {
    "piToClaude": "result.md or question.md only",
    "paneAddressing": "validated tmux %<id> only",
    "negativeExamples": "maintainer-only; excluded from generated Pi prompts"
  }
}
