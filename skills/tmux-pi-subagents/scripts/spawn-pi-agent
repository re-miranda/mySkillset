#!/usr/bin/env bash
set -euo pipefail

show_usage() {
  cat <<'USAGE'
Usage: spawn-pi-agent [options] <name> [task text...]

Spawns a Pi companion in a tmux split pane. On Pi 0.80.10, the @brief.md
argument auto-runs; launch is verified through the session journal and recovered once.

Options:
  --thinking, -t <level>     Pi thinking level: low, medium, high, xhigh (default: high)
  --direction, -d <dir>      Split direction: right, down, left, up (default: right)
  --task-file <path>         Read task text from this file instead of argv/stdin
  --workdir <path>           Working directory for Pi (default: current directory)
  --source-pane <pane-id>    Caller pane ID (default: $TMUX_PANE; must be %<number>)
  --root <path>              Agent state root (default: /tmp/claude-agents)
  --dry-run                  Write files and print the launch command, but do not spawn
  --help, -h                 Show this help

Task text can also be provided on stdin.
USAGE
}

fail_spawn_pi_agent() {
  printf 'spawn-pi-agent: %s\n' "$1" >&2
  exit 1
}

quote_shell_arg() {
  printf '%q' "$1"
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail_spawn_pi_agent "required command not found: $1"
}

validate_agent_name() {
  local name="$1"
  [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || \
    fail_spawn_pi_agent "invalid name '$name' (expected 1-64 chars: letters, numbers, dot, underscore, dash; must start alphanumeric)"
}

read_stdin_task() {
  local task=""
  if [ -t 0 ]; then
    printf '%s' "$task"
    return
  fi
  task=$(cat)
  printf '%s' "$task"
}

archive_existing_path() {
  local path="$1" archive_dir="$2" stamp="$3"
  [ -e "$path" ] || [ -L "$path" ] || return 0
  mkdir -p "$archive_dir"
  mv -f "$path" "$archive_dir/${stamp}-$(basename "$path")"
}

write_text_file() {
  local path="$1" content="$2"
  printf '%s\n' "$content" > "$path"
}

write_system_prompt() {
  local path="$1" result_path="$2" question_path="$3"
  cat > "$path" <<EOF
You are a companion executor to Claude (orchestrator). Claude owns all consequential decisions. You execute, surface findings, and flag decisions you cannot make unilaterally.

The initial brief was supplied to Pi as an @file argument. Start work from that brief immediately; do not wait for an extra typed prompt.

Your only communication channel to Claude is the two files below. Claude already watches them; do not attempt any other parent notification.

When done, write your final result to:
$result_path

If blocked or you need a decision from Claude, write a concise question to:
$question_path

Question files should include: blocker, relevant context, options considered, and your recommendation. After writing a question, wait for Claude's reply, then continue the task.
EOF
}

write_brief_file() {
  local path="$1" name="$2" task="$3" workdir="$4" result_path="$5" question_path="$6" run_dir="$7"
  cat > "$path" <<EOF
# Brief: $name

## Task
$task

## Working directory
$workdir

## Run files
- Run directory: $run_dir
- Result path: $result_path
- Question path: $question_path

## Communication contract
Claude already watches the two run files. They are your only communication channel to Claude.

- Finished: write the summary to the result path.
- Blocked: write the question path, then wait for Claude's reply.

Flag anything that needs a decision from Claude instead of guessing.
EOF
}

parse_spawn_args() {
  thinking="high" direction="right" task_file="" workdir="" source_pane="" root="/tmp/claude-agents" dry_run="0" name=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --thinking|-t) thinking="${2:-}"; shift 2 ;;
      --direction|-d) direction="${2:-}"; shift 2 ;;
      --task-file) task_file="${2:-}"; shift 2 ;;
      --workdir) workdir="${2:-}"; shift 2 ;;
      --source-pane|--orchestrator) source_pane="${2:-}"; shift 2 ;;
      --root) root="${2:-}"; shift 2 ;;
      --dry-run) dry_run="1"; shift ;;
      --help|-h) show_usage; exit 0 ;;
      --) shift; break ;;
      -*) fail_spawn_pi_agent "unknown option: $1" ;;
      *) name="$1"; shift; break ;;
    esac
  done
  remaining_args=("$@")
}

load_task_text() {
  if [ -n "$task_file" ]; then
    [ -f "$task_file" ] || fail_spawn_pi_agent "task file not found: $task_file"
    task=$(cat "$task_file")
    return
  fi
  if [ "${#remaining_args[@]}" -gt 0 ]; then
    task="${remaining_args[*]}"
    return
  fi
  task=$(read_stdin_task)
}

validate_inputs() {
  [ -n "$name" ] || { show_usage >&2; exit 2; }
  validate_agent_name "$name"
  [ -n "${task//[[:space:]]/}" ] || fail_spawn_pi_agent "empty task; pass task text, --task-file, or stdin"
  [ -n "$workdir" ] || workdir=$(pwd)
  [ -d "$workdir" ] || fail_spawn_pi_agent "workdir not found: $workdir"
}

resolve_source_pane() {
  local resolved=""
  [ -n "$source_pane" ] || source_pane="${TMUX_PANE:-}"
  [[ "$source_pane" =~ ^%[0-9]+$ ]] || \
    fail_spawn_pi_agent "invalid source pane '$source_pane' (expected stable tmux pane ID like %3 via --source-pane or TMUX_PANE)"
  require_command tmux
  resolved=$(tmux display-message -t "$source_pane" -p '#{pane_id}' 2>/dev/null || true)
  [ "$resolved" = "$source_pane" ] || \
    fail_spawn_pi_agent "source pane '$source_pane' was not found (expected a live tmux pane ID)"
}

validate_runtime_commands() {
  [ "$dry_run" = "1" ] && return
  require_command pi
  require_command tmux
  [ -x "$script_dir/verify-pi-delivery" ] || \
    fail_spawn_pi_agent "delivery helper '$script_dir/verify-pi-delivery' is not executable (expected an installed executable helper)"
}

refuse_live_name_reuse() {
  local pane_file="$root/$name.pane" prior_pane="" resolved=""
  [ -f "$pane_file" ] || return 0
  prior_pane=$(tr -d '[:space:]' < "$pane_file")
  [[ "$prior_pane" =~ ^%[0-9]+$ ]] || return 0
  resolved=$(tmux display-message -t "$prior_pane" -p '#{pane_id}' 2>/dev/null || true)
  [ "$resolved" != "$prior_pane" ] || \
    fail_spawn_pi_agent "name '$name' already maps to live pane '$prior_pane' (expected a unique name for each live agent)"
}

generate_session_id() {
  local uuid_path="/proc/sys/kernel/random/uuid"
  [ -r "$uuid_path" ] || \
    fail_spawn_pi_agent "UUID source '$uuid_path' is unreadable (expected a Linux kernel UUID source)"
  session_id=$(tr -d '[:space:]' < "$uuid_path")
  [[ "$session_id" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]] || \
    fail_spawn_pi_agent "generated session ID '$session_id' (expected a UUID)"
}

capture_runtime_versions() {
  pi_version="unavailable"
  tmux_version="unavailable"
  if command -v pi >/dev/null 2>&1; then
    pi_version=$(pi --version 2>&1) || \
      fail_spawn_pi_agent "pi version command failed for 'pi --version' (expected a version string)"
  fi
  if command -v tmux >/dev/null 2>&1; then
    tmux_version=$(tmux -V 2>&1) || \
      fail_spawn_pi_agent "tmux version command failed for 'tmux -V' (expected a version string)"
  fi
}

prepare_run_paths() {
  stamp=$(date -u +%Y%m%dT%H%M%SZ)
  run_dir="$root/runs/${stamp}-${name}"
  [ ! -e "$run_dir" ] || run_dir="$root/runs/${stamp}-${name}-$$"
  archive_dir="$root/archive"
  brief_path="$run_dir/brief.md"
  system_path="$run_dir/system.md"
  result_path="$run_dir/result.md"
  question_path="$run_dir/question.md"
  meta_path="$run_dir/meta.env"
  command_path="$run_dir/launch.sh"
  generate_session_id
  mkdir -p "$run_dir"
}

archive_active_links() {
  archive_existing_path "$root/$name.md" "$archive_dir" "$stamp"
  archive_existing_path "$root/$name.system.md" "$archive_dir" "$stamp"
  archive_existing_path "$root/$name.result.md" "$archive_dir" "$stamp"
  archive_existing_path "$root/$name.question.md" "$archive_dir" "$stamp"
  archive_existing_path "$root/$name.pane" "$archive_dir" "$stamp"
  archive_existing_path "$root/$name.run" "$archive_dir" "$stamp"
  archive_existing_path "$root/$name.meta" "$archive_dir" "$stamp"
}

link_active_files() {
  ln -s "$brief_path" "$root/$name.md"
  ln -s "$system_path" "$root/$name.system.md"
  ln -s "$result_path" "$root/$name.result.md"
  ln -s "$question_path" "$root/$name.question.md"
  printf '%s\n' "$run_dir" > "$root/$name.run"
  ln -s "$meta_path" "$root/$name.meta"
}

build_commands() {
  local workdir_q system_q brief_arg_q pi_name_q thinking_q session_id_q root_q watch_bin_q
  workdir_q=$(quote_shell_arg "$workdir")
  system_q=$(quote_shell_arg "$system_path")
  brief_arg_q=$(quote_shell_arg "@$brief_path")
  pi_name_q=$(quote_shell_arg "$name")
  thinking_q=$(quote_shell_arg "$thinking")
  session_id_q=$(quote_shell_arg "$session_id")
  root_q=$(quote_shell_arg "$root")
  watch_bin_q=$(quote_shell_arg "$script_dir/watch-pi-agent")
  pi_cmd="cd $workdir_q && pi --name $pi_name_q --thinking $thinking_q --session-id $session_id_q --append-system-prompt $system_q $brief_arg_q"
  watch_cmd="$watch_bin_q --root $root_q $pi_name_q"
}

write_run_files() {
  write_system_prompt "$system_path" "$result_path" "$question_path"
  write_brief_file "$brief_path" "$name" "$task" "$workdir" "$result_path" "$question_path" "$run_dir"
  write_text_file "$command_path" "#!/usr/bin/env bash
$pi_cmd"
  chmod 700 "$command_path"
}

write_meta_file() {
  cat > "$meta_path" <<EOF
name=$name
pane=$pane
run_dir=$run_dir
brief_path=$brief_path
system_path=$system_path
result_path=$result_path
question_path=$question_path
workdir=$workdir
source_pane=$source_pane
thinking=$thinking
direction=$direction
started_at=$stamp
session_id=$session_id
pi_version=$pi_version
tmux_version=$tmux_version
command=$pi_cmd
watch=$watch_cmd
EOF
}

split_flags_for_direction() {
  case "$direction" in
    right) split_flags=("-h") ;;
    down) split_flags=("-v") ;;
    left) split_flags=("-h" "-b") ;;
    up) split_flags=("-v" "-b") ;;
    *) fail_spawn_pi_agent "invalid direction '$direction' (expected right, down, left, or up)" ;;
  esac
}

spawn_pane() {
  local split_flags=()
  split_flags_for_direction
  pane=$(tmux split-window "${split_flags[@]}" -t "$source_pane" -P -F '#{pane_id}' "$pi_cmd")
  [ -n "$pane" ] || fail_spawn_pi_agent "tmux split-window did not return a pane id"
  printf '%s\n' "$pane" > "$root/$name.pane"
}

report_launch_recovery_error() {
  printf 'spawn-pi-agent: %s\n' "$1" >&2
  return 1
}

resolve_launch_recovery_pane() {
  local pane_path="$root/$name.pane" resolved=""
  [ -f "$pane_path" ] || { report_launch_recovery_error \
    "pane mapping '$pane_path' is missing (expected the recorded launch pane)"; return 1; }
  recovery_pane=$(tr -d '[:space:]' < "$pane_path")
  [[ "$recovery_pane" =~ ^%[0-9]+$ ]] || { report_launch_recovery_error \
    "invalid pane mapping '$recovery_pane' (expected stable tmux pane ID like %3)"; return 1; }
  resolved=$(tmux display-message -t "$recovery_pane" -p '#{pane_id}' 2>/dev/null || true)
  [ "$resolved" = "$recovery_pane" ] || { report_launch_recovery_error \
    "stale pane mapping '$recovery_pane' (expected a live tmux pane ID)"; return 1; }
  tmux capture-pane -t "$recovery_pane" -p -S -12 || { report_launch_recovery_error \
    "could not capture pane '$recovery_pane' (expected a readable live Pi pane)"; return 1; }
}

resubmit_launch_brief() {
  local recovery_text="Read $brief_path and start work on it now."
  resolve_launch_recovery_pane || return 1
  tmux send-keys -t "$recovery_pane" -l "$recovery_text" || { report_launch_recovery_error \
    "could not send recovery text to '$recovery_pane' (expected a writable live Pi pane)"; return 1; }
  sleep 1 || { report_launch_recovery_error \
    "recovery delay failed for pane '$recovery_pane' (expected a one-second sleep)"; return 1; }
  tmux send-keys -t "$recovery_pane" Enter || { report_launch_recovery_error \
    "could not submit recovery text to '$recovery_pane' (expected unmodified Enter delivery)"; return 1; }
}

verify_brief_delivery() {
  local timeout="$1" marker
  marker=$(basename "$brief_path")
  "$script_dir/verify-pi-delivery" "$name" --root "$root" \
    --marker "$marker" --timeout "$timeout"
}

ensure_launch_delivery() {
  if verify_brief_delivery 25; then
    return 0
  fi
  printf 'spawn-pi-agent: initial brief was not verified; retrying once with Enter\n' >&2
  resubmit_launch_brief || return 1
  verify_brief_delivery 20
}

print_launch_summary() {
  printf 'NAME=%s\nPANE=%s\nSESSION_ID=%s\nRUN_DIR=%s\nBRIEF=%s\nRESULT=%s\nQUESTION=%s\nPOLL=/poll %s\nWATCH=%s\n' \
    "$name" "$pane" "$session_id" "$run_dir" "$brief_path" "$result_path" "$question_path" "$name" "$watch_cmd"
}

print_dry_run_summary() {
  printf 'DRY_RUN=1\nNAME=%s\nSESSION_ID=%s\nRUN_DIR=%s\nBRIEF=%s\nRESULT=%s\nQUESTION=%s\nCOMMAND=%s\nWATCH=%s\n' \
    "$name" "$session_id" "$run_dir" "$brief_path" "$result_path" "$question_path" "$pi_cmd" "$watch_cmd"
}

run_spawn() {
  validate_inputs
  resolve_source_pane
  validate_runtime_commands
  refuse_live_name_reuse
  prepare_run_paths
  capture_runtime_versions
  build_commands
  write_run_files
  archive_active_links
  link_active_files
}

complete_live_spawn() {
  spawn_pane
  write_meta_file
  print_launch_summary
  if ensure_launch_delivery; then
    printf 'LAUNCH=ok\n'
    return 0
  fi
  printf 'LAUNCH=failed\n'
  return 1
}

main() {
  script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
  parse_spawn_args "$@"
  load_task_text
  run_spawn

  pane=""
  if [ "$dry_run" = "1" ]; then
    write_meta_file
    print_dry_run_summary
    return 0
  fi
  complete_live_spawn
}

main "$@"
